[Unit]
Description=xsec_alpha weekly model retrain (F1 pipeline: unified features, absolute target, promotion gate)
After=network.target xsec-alpha.service
Before=xsec-measure.service

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/mnt/20t/main/gan_t/xsec_alpha
EnvironmentFile=/mnt/20t/main/gan_t/.env
# F1 (2026-04-25): retrain both horizons on unified 10-feature pipeline.
# Includes pre-flight (data freshness, lock), promotion gate (IC delta + floor),
# auto-archive on promote, and calibration rebuild.
# Fetch fresh data first — main service does this too. Without it the retrain
# timer fires Sun 20:00 UTC right when DB latest is 17:00 UTC = ~3.005h old,
# tripping MAX_DATA_AGE_HOURS=3 deterministically (observed 2026-05-03).
ExecStartPre=/home/soccz/.pyenv/versions/3.12.9/bin/python scripts/update_data.py
ExecStart=/home/soccz/.pyenv/versions/3.12.9/bin/python scripts/retrain_pipeline.py
TimeoutStartSec=1200
Restart=on-failure
RestartSec=60
StandardOutput=append:/mnt/20t/main/gan_t/xsec_alpha/logs/retrain.log
StandardError=append:/mnt/20t/main/gan_t/xsec_alpha/logs/retrain.log
