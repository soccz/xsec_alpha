[Unit]
Description=xsec_alpha cross-sectional ranking
StartLimitIntervalSec=3600
StartLimitBurst=3
After=network.target
Before=xsec-retrain.service xsec-measure.service
OnFailure=xsec-telegram-failure.service

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/mnt/20t/main/gan_t/xsec_alpha
EnvironmentFile=/mnt/20t/main/gan_t/.env
ExecStartPre=/home/soccz/.pyenv/versions/3.12.9/bin/python scripts/update_data.py
ExecStartPre=/home/soccz/.pyenv/versions/3.12.9/bin/python scripts/track_ic.py
ExecStart=/home/soccz/.pyenv/versions/3.12.9/bin/python scripts/fetch_and_rank.py
TimeoutStartSec=600
Restart=on-failure
RestartSec=60
StandardOutput=append:/mnt/20t/main/gan_t/xsec_alpha/logs/systemd.log
StandardError=append:/mnt/20t/main/gan_t/xsec_alpha/logs/systemd.log
