# User unit. Install with: bash deploy/install_backup.sh
[Unit]
Description=xsec_alpha SQLite DB backup (hot, integrity-checked)

[Service]
Type=oneshot
WorkingDirectory=/mnt/20t/main/gan_t/xsec_alpha
ExecStart=/bin/bash /mnt/20t/main/gan_t/xsec_alpha/scripts/backup_db.sh
TimeoutStartSec=600
StandardOutput=append:/mnt/20t/main/gan_t/xsec_alpha/logs/backup.log
StandardError=append:/mnt/20t/main/gan_t/xsec_alpha/logs/backup.log
